# Template for .env.build (untracked, gitignored — real secrets/refs live there, never here).
# Copy this file to .env.build and it should work as-is, since every value below is
# already a live 1Password reference (a pointer, not a secret — safe to track per
# CLAUDE.md's "hard line is values, not pointers").
#
#   cp env.build.example .env.build
#
# Then run either build script via:
#   op run --env-file=.env.build -- ./scripts/build-dmg.sh
#   op run --env-file=.env.build -- ./scripts/build-ipa.sh
#
# All values are in 1Password vault "AI":
#   - item "Apple Developer (notarytool)" (s7ljc4rydkrfgfrim5nsyz43ci) — notarization
#     Apple ID + app-specific password, Team ID, and the Sparkle EdDSA private key
#   - item "Dicticus App Store Connect API Key" (bdr7lzu4du62aljzvyyomsyv64) — the
#     App Store Connect API key used for iOS archive/export/upload
#
# NOT listed here (deliberately no longer variables in the real file — see the
# scripts' own header comments for why):
#   - OP_DEVID_P12_REF (macOS Developer ID cert auto-restore, scripts/_signing-guard.sh)
#     — an item ID, not a secret; pass inline instead: OP_DEVID_P12_REF=<id> op run ...
#   - APP_STORE_CONNECT_API_KEY_PATH — derived automatically by build-ipa.sh from
#     APP_STORE_CONNECT_KEY_ID (Apple's own ~/.appstoreconnect/private_keys/AuthKey_<ID>.p8
#     convention); a separately-tracked path variable caused a real incident 2026-09-13
#     (the path and the ID silently drifted out of sync — see build-ipa.sh's header).
#     The .p8 file itself must exist locally; back a copy up to the 1Password item above.

DEVELOPER_TEAM_ID="op://AI/s7ljc4rydkrfgfrim5nsyz43ci/Team ID"
APPLE_ID="op://AI/s7ljc4rydkrfgfrim5nsyz43ci/username"
APPLE_APP_SPECIFIC_PASSWORD="op://AI/s7ljc4rydkrfgfrim5nsyz43ci/password"
SPARKLE_PRIVATE_KEY="op://AI/s7ljc4rydkrfgfrim5nsyz43ci/Sparkle Private Key"

APP_STORE_CONNECT_KEY_ID="op://AI/bdr7lzu4du62aljzvyyomsyv64/Key ID"
APP_STORE_CONNECT_ISSUER_ID="op://AI/bdr7lzu4du62aljzvyyomsyv64/Issuer ID"
