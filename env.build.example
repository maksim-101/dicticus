# Template for .env.build (untracked and gitignored; your values or secret-manager
# references live there, never here).
#
#   cp env.build.example .env.build
#
# Fill in each value below. The build scripts read these variables from the environment,
# not from the file, so load the file when you run a script:
#   set -a; source .env.build; set +a
#   ./scripts/build-dmg.sh   (macOS: build, sign, notarize, DMG)
#   ./scripts/build-ipa.sh   (iOS: archive, export, upload to TestFlight)
# or let a secret manager resolve references in the file at run time, for example
# 1Password: op run --env-file=.env.build -- ./scripts/build-dmg.sh
#
# Where the values come from:
#   - DEVELOPER_TEAM_ID, APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD: your Apple Developer account
#     (notarization uses an app-specific password)
#   - SPARKLE_PRIVATE_KEY: the EdDSA private key that signs appcast entries
#     (Sparkle's generate_keys); its public half is SUPublicEDKey in the app's Info.plist
#   - APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID: an App Store Connect API key
#   - DEVID_SIGNING_HASH: the SHA-1 of your Developer ID Application identity
#     (security find-identity -v -p codesigning); not a secret, but personal
#
# Not variables here (see the scripts' own header comments):
#   - APP_STORE_CONNECT_API_KEY_PATH is derived by build-ipa.sh from APP_STORE_CONNECT_KEY_ID
#     (Apple's ~/.appstoreconnect/private_keys/AuthKey_<ID>.p8 convention); the .p8 file
#     itself must exist locally.
#
# A value left empty stops the scripts at their check for missing variables.

DEVELOPER_TEAM_ID=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
SPARKLE_PRIVATE_KEY=

APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=

DEVID_SIGNING_HASH=
